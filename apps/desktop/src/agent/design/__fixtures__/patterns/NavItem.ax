          ]
        }
      ]
    }
  },
  "pages": [
    {
      "id": "nav-page",
      "name": "NavItem 模式",
      "width": 240,
      "height": 360,
      "layout": "vertical",
      "tree": [
        { "id": "n1", "kind": "component", "name": "NavItem", "props": { "label": "仪表盘" } },
        { "id": "n2", "kind": "component", "name": "NavItem", "props": { "label": "订单管理" } },
        { "id": "n3", "kind": "component", "name": "NavItem", "props": { "label": "用户管理" } },
        { "id": "n4", "kind": "component", "name": "NavItem", "props": { "label": "设置" } }
      ]
