{
  "ax": "1.4",
  "name": "NavItem",
  "tokens": {},
  "components": {},
  "symbols": {
    "NavItem": {
      "props": { "label": "string" },
      "body": [
        {
          "id": "nav-root",
          "kind": "frame",
          "layout": "horizontal",
          "gap": 8,
          "padding": [8, 12, 8, 12],
          "width": "fill_container",
          "alignItems": "center",
          "children": [
