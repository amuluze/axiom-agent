{
  "schemaVersion": 1,
  "description": "Provider 单一数据来源。修改后运行 `npm run generate:providers` 重新生成 Rust/TS 数据段并提交。版本推进纪律：纯数据增量（新增模型/新增 provider）transportVersion 保持 '6' 即可，semanticDigest 自动重算；改传输行为（probe 体/header/path 补全）必须手动 bump transportVersion 再重新生成。",
  "constants": {
    "timeoutMinMs": 1000,
    "timeoutMaxMs": 300000,
    "timeoutDefaultMs": 60000,
    "maxOutputMin": 1,
    "maxOutputMax": 64000,
    "maxOutputDefault": 4096,
    "contextMin": 8192,
    "contextMax": 2000000,
    "contextDefault": 128000,
    "identifierMaxBytes": 128,
    "endpointMaxBytes": 4096,
    "modelIdMaxBytes": 256
  },
