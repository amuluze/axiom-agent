{
  "name": "axiom",
  "private": true,
  "version": "0.7.1",
  "description": "Local-first desktop agent with a first-party runtime.",
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "dev": "npm run dev --workspace @axiom/desktop",
    "tauri": "npm run tauri --workspace @axiom/desktop --",
    "build": "npm run build --workspace @axiom/desktop",
    "build:windows": "npm run tauri -- build --bundles nsis",
    "typecheck": "npm run typecheck --workspace @axiom/desktop",
    "lint:ts": "biome check",
    "lint:ts:fix": "biome check --write",
    "test": "npm run test --workspace @axiom/desktop",
    "test:coverage": "npm run test:coverage --workspace @axiom/desktop",
    "generate:providers:check": "node scripts/generate-provider-sources.mjs --check",
    "generate:bash-policy": "node scripts/generate-bash-policy.mjs",
    "generate:bash-policy:check": "node scripts/generate-bash-policy.mjs --check",
    "test:capabilities": "node scripts/tauri-capability-audit.mjs",
    "test:bash-policy": "node scripts/bash-policy-audit.mjs",
    "test:docs-path": "node scripts/docs-path-audit.mjs --self-test",
    "test:import-boundary": "node scripts/import-boundary-audit.mjs",
    "e2e:install": "npm ci --prefix e2e",
    "e2e:validate": "npm run validate --prefix e2e",
    "e2e:test": "npm test --prefix e2e",
    "check": "npm run generate:providers:check && npm run generate:bash-policy:check && npm run typecheck && npm run test:import-boundary && npm run lint:ts && npm run test:capabilities && npm run test:bash-policy && npm run test:docs-path && npm run test:coverage && npm run test:rust && npm run fmt:rust && npm run lint:rust && npm run build && npm run check:rust",
    "check:rust": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml --locked",
    "check:rust:targets": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml --locked --target aarch64-apple-darwin && cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml --locked --target x86_64-apple-darwin",
    "fmt:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all -- --check",
    "lint:rust": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --locked",
    "test:migrations": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --locked session_repository::tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "26.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.11.21",
    "browserslist": "^4.28.9"
  }
}
